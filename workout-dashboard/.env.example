# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key (Project Settings -> API -> service_role). Bypasses RLS —
# used ONLY server-side by the Oura scheduled sync job. Never expose this
# with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Oura API app (cloud.ouraring.com/oauth/applications) — register redirect
# URIs for both http://localhost:3000/api/integrations/oura/callback and
# your production domain's equivalent.
OURA_CLIENT_ID=your-oura-client-id
OURA_CLIENT_SECRET=your-oura-client-secret

# AES-256-GCM key used to encrypt OAuth tokens at rest. Generate with:
#   openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when
# calling /api/cron/sync. Optional locally, but set it in production so the
# sync endpoint can't be triggered by anyone who finds the URL. Generate with:
#   openssl rand -hex 32
CRON_SECRET=
